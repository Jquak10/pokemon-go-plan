{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pokemon-go-personal-calendar",
  "workers_dev": false,
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/calendar/*",
      "/manage/*",
      "/admin"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokemon-go-calendar-db",
      "database_id": "a164c5c3-abaf-4900-92fa-c3f2c6a95d1e"
    }
  ],
  "ratelimits": [
    {
      "name": "PLANNER_CREATE_CLIENT_RATE_LIMITER",
      "namespace_id": "2026092201",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "PLANNER_CREATE_ROUTE_RATE_LIMITER",
      "namespace_id": "2026092202",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
"triggers": {
  "crons": [
    "23 */6 * * *",
    "33 */6 * * *",
    "43 */6 * * *"
  ]
},
  "observability": {
    "enabled": true
  }
}
