{
  "name": "Pokemon GO Planner",

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "workspaceFolder": "/workspace",

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",

  "forwardPorts": [
    8787
  ],

  "portsAttributes": {
    "8787": {
      "label": "Pokemon GO Planner",
      "onAutoForward": "notify"
    }
  },

  "mounts": [
    "source=pogo-codex,target=/root/.codex,type=volume",
    "source=pogo-gh,target=/root/.config/gh,type=volume"
  ],

  "postCreateCommand": "if [ -f package-lock.json ]; then npm ci; elif [ -f package.json ]; then npm install; fi",

  "remoteUser": "root"
}